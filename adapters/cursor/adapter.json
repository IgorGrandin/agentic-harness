{
  "schemaVersion": 1,
  "id": "cursor",
  "installMode": "always",
  "instructionOutput": "adapters/cursor/rules/agentic-harness.mdc",
  "instructionSources": [
    "adapters/cursor/header.mdc",
    "core/policies/context-memory.md",
    "core/policies/session-lifecycle.md",
    "core/policies/evidence.md",
    "core/policies/security-permissions.md",
    "profiles/catalog.md",
    "memory/domains.md",
    "profiles/coder/PROFILE.md",
    "adapters/cursor/runtime.md"
  ],
  "destinations": {
    "rules": "~/.cursor/rules/agentic-harness.mdc",
    "memory": "~/.cursor/memory-bank/",
    "agents": "~/.cursor/agents/",
    "skills": "~/.agents/skills/",
    "mcp": "~/.cursor/mcp.json (user-managed)"
  }
}
